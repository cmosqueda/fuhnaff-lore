# All optional — sensible defaults are baked in, override only if needed.

# Vite build base path. Leave unset: vite.config.ts already picks "/" on
# Vercel (via the auto-set VERCEL var) and "/fuhnaff-lore" everywhere else
# (for GitHub Pages). Set this only to force a specific path.
# BASE_PATH=/

# Which wiki the lore discovery pipeline (lib/lore, scripts/fetch-lore.mjs,
# api/lore.js) reads from.
# LORE_WIKI_BASE_URL=https://freddy-fazbears-pizza.fandom.com

# User-Agent sent with every wiki API request (Fandom asks for a
# descriptive one that identifies the project/contact).
# LORE_USER_AGENT=fnaf-cards-lore-fetch/1.0 (github.com/cmosqueda/fuhnaff-lore)
